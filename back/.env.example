# Copiar como .env para la configuración local. No subir el .env real.
# Valor por defecto: archivo SQLite relativo al ejecutar desde back.
DATABASE_URL=sqlite:///./exoma_care.db

# Generar UNA VEZ con:
# .venv/Scripts/python.exe -c "import secrets; print(secrets.token_hex(32))"
# Pegar el resultado a continuación. No es el JWT de un usuario.
# URL y clave de Apigen. Completar desde la configuración local aprobada.
API_GEN_URL=
API_SECRET_KEY_API_GEN=
# URL y clave del catálogo de patologías CDSS.
CDSS_BASE_URL=
CDSS_API_KEY=
# Servicio externo de notificaciones. La clave nunca debe exponerse al frontend.
NOTIFICATIONS_BASE_URL=
NOTIFICATIONS_API_KEY=
# Para instalaciones existentes también se acepta API_SECRET_KEY_API_NOTIFICATIONS.
JWT_SECRET_KEY=

# GenLab: completar solo en backend; no usar prefijo VITE_.
CHATBOT_URL=
CHATBOT_APIKEY=
CHATBOT_TOKEN=

# Cupones de descuento (otro grupo). Clave del grupo: pedirla, no subirla.
# CUPONES_GERENTE_ID queda fijado por el primer POST a la API: elegir un valor y no cambiarlo.
CUPONES_BASE_URL=
CUPONES_API_KEY=
CUPONES_GERENTE_ID=

# Obras sociales (Grupo 9). Clave del grupo: pedirla, no subirla.
OBRAS_SOCIALES_BASE_URL=
OBRAS_SOCIALES_API_KEY=

# Módulo de optimización de recorridos (otro grupo, sin clave).
RECORRIDOS_API_URL=https://optimizacionapi.vercel.app/api/optimizacion
# Laboratorio Central (Calle 62 N° 555, La Plata): partida y destino del recorrido.
CENTRAL_LAB_LATITUDE=-34.921559
CENTRAL_LAB_LONGITUDE=-57.938362

# API de FedEx (módulo 10, otro grupo). Usuario y contraseña del grupo: pedirlos, no subirlos.
FEDEX_URL=
FEDEX_USER=
FEDEX_PASS=

# Herramientas de demo: simulador del bot de extracción para el administrativo (true/false).
DEMO_TOOLS_ENABLED=false

# Secreto compartido con el bot de extracción (simulado: scripts/simular_aviso_extraccion.py).
# Generar con el mismo comando que JWT_SECRET_KEY. Vacío: el webhook responde 401 a todo.
EXTRACTION_WEBHOOK_SECRET=

# Integraciones clínicas: claves exclusivamente del servidor.
SNOMED_URL=https://hwmpslajqivdqeaylhdc.supabase.co/functions/v1/terminologia/sintomas
SNOMED_API_KEY=
SNOMED_REGION=us-east-1
FAMILIOGRAM_BASE_URL=https://cnylfdemauswqeqmvwmz.supabase.co/functions/v1/familiograma
FAMILIOGRAM_API_KEY=
APIGEN_GROUP_ID=grupo6
