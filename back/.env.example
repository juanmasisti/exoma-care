# Copiar como .env para la configuración local. No subir el .env real.
# Valor por defecto: archivo SQLite relativo al ejecutar desde back.
DATABASE_URL=sqlite:///./exoma_care.db

# Generar UNA VEZ con:
# .venv/Scripts/python.exe -c "import secrets; print(secrets.token_hex(32))"
# Pegar el resultado a continuación. No es el JWT de un usuario.
JWT_SECRET_KEY=

# Módulo de optimización de recorridos (otro grupo, sin clave).
RECORRIDOS_API_URL=https://optimizacionapi.vercel.app/api/optimizacion
# Laboratorio Central (Calle 62 N° 555, La Plata): partida y destino del recorrido.
CENTRAL_LAB_LATITUDE=-34.921559
CENTRAL_LAB_LONGITUDE=-57.938362

# Secreto compartido con el bot de extracción (simulado: scripts/simular_aviso_extraccion.py).
# Generar con el mismo comando que JWT_SECRET_KEY. Vacío: el webhook responde 401 a todo.
EXTRACTION_WEBHOOK_SECRET=
